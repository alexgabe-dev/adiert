# Optional server-only canonical URL used for metadata and authentication callbacks.
# Production: https://www.palackverseny.hu (set SITE_URL in Vercel).
SITE_URL="http://localhost:3001"

# Server-only Supabase connection used by SSR, auth, and API routes.
# On Vercel, set these names in Production and Preview, then redeploy.
# Legacy NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are also accepted.
# Use a different Supabase project in local, staging, and production environments.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY="your-anon-key"

# Privileged server-only credential. Never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only HMAC secret for anonymous rate-limit and idempotency keys (at least 32 random chars).
SUBMISSION_RATE_LIMIT_SECRET="replace-with-a-long-random-environment-specific-secret"
# School portal notifications (server-only). Supabase Auth sends confirmation/password emails.
RESEND_API_KEY=""
NOTIFICATION_FROM="Ádiért <info@palackverseny.hu>"
# At least 32 random characters; used by the private recurring notification dispatcher.
NOTIFICATION_CRON_SECRET=""

# Optional admin password entry for a local development app only.
LOCAL_TEST_LOGIN="false"
