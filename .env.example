# Canonical public URL used for metadata. Set this to the deployed HTTPS origin.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Use a different Supabase project in local, staging, and production environments.
# The URL and anon key are public identifiers; RLS is still mandatory.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only. Never prefix this variable with NEXT_PUBLIC_ and never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
